@model IEnumerable<TechAssetManagement.Core.Entities.Ticket>

@{
    ViewData["Title"] = "Tickets de Soporte";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-ticket-alt"></i> Tickets de Soporte</h2>

    <!-- BOTÓN DE CREAR TICKET -->
    <!-- Verifica que esta línea exista y esté fuera de cualquier IF restrictivo -->
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nuevo Ticket
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Asunto</th>
                    <th>Equipo</th>
                    <th>Solicitante</th>
                    <th>Estado</th>
                    <th>Acciones</th> <!-- Columna de acciones -->
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.Asset?.Name</td>
                        <td>@item.RequestedByUser?.FullName</td>
                        <td>
                            <span class="badge bg-secondary">@item.Status</span>
                        </td>
                        <td>
                            <!-- BOTÓN DE GESTIONAR / EDITAR -->
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">
                                <i class="fas fa-edit"></i> Gestionar
                            </a>

                            <!-- Botón de Detalles (Opcional) -->
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="alert alert-info mt-3">
                No hay tickets registrados para mostrar.
            </div>
        }
    </div>
</div>