@model TechAssetManagement.Core.Entities.Ticket

@{
    ViewData["Title"] = "Gestionar Ticket";
    var userRole = Context.Session.GetString("UserRole");
    bool isAdmin = userRole == "Admin";
    bool isTech = userRole == "Technician";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="fas fa-tools"></i> Gestionar Ticket #@Model.Id</h4>
                    <span class="badge bg-dark text-white">Rol actual: @userRole</span>
                </div>
                <div class="card-body">

                    <form asp-action="Edit" id="editForm">
                        <input type="hidden" asp-for="Id" />

                        <!-- INFORMACIÓN DE LECTURA (Nadie puede editar esto aquí para mantener integridad) -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card bg-light border-0">
                                    <div class="card-body p-3">
                                        <h6 class="text-muted text-uppercase mb-1">Problema</h6>
                                        <p class="fw-bold mb-0">@Model.Title</p>
                                        <hr class="my-2" />
                                        <small>@Model.Description</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light border-0">
                                    <div class="card-body p-3">
                                        <h6 class="text-muted text-uppercase mb-1">Equipo & Solicitante</h6>
                                        <p class="mb-1"><i class="fas fa-laptop"></i> @(Model.Asset?.Name ?? "N/A")</p>
                                        <p class="mb-0"><i class="fas fa-user"></i> @(Model.RequestedByUser?.FullName ?? "N/A")</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <!-- SECCIÓN DE GESTIÓN (Editable según rol) -->
                        <div class="row">
                            <!-- 1. ESTADO -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="Status" class="form-label fw-bold">Estado del Ticket</label>
                                @if (isAdmin || isTech)
                                {
                                    <select asp-for="Status" class="form-select border-primary">
                                        <option value="Open">Abierto</option>
                                        <option value="InProgress">En Progreso</option>
                                        <option value="Waiting">En Espera</option>
                                        <option value="Closed">Cerrado / Resuelto</option>
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="@Model.Status" readonly />
                                    <!-- Importante: Enviar el valor aunque sea readonly -->
                                    <input type="hidden" asp-for="Status" />
                                }
                            </div>

                            <!-- 2. PRIORIDAD (Solo Admin) -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="Priority" class="form-label fw-bold">Prioridad</label>
                                @if (isAdmin)
                                {
                                    <select asp-for="Priority" class="form-select">
                                        <option value="Low">Baja</option>
                                        <option value="Medium">Media</option>
                                        <option value="High">Alta</option>
                                        <option value="Critical">Crítica</option>
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="@Model.Priority" readonly />
                                    <input type="hidden" asp-for="Priority" />
                                }
                            </div>

                            <!-- 3. TÉCNICO ASIGNADO (Solo Admin) -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="AssignedToUserId" class="form-label fw-bold">Técnico Asignado</label>
                                @if (isAdmin)
                                {
                                    <select asp-for="AssignedToUserId" class="form-select" asp-items="ViewBag.Technicians">
                                        <option value="">-- Sin Asignar --</option>
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="@(Model.AssignedToUser?.FullName ?? "Pendiente")" readonly />
                                    <input type="hidden" asp-for="AssignedToUserId" />
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4 gap-2">
                            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

                            @if (isAdmin || isTech)
                            {
                                <button type="button" onclick="confirmUpdate()" class="btn btn-success px-4">
                                    <i class="fas fa-save"></i> Guardar Cambios
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmUpdate() {
            Swal.fire({
                title: '¿Guardar cambios?',
                text: "Se registrará este evento en el historial de auditoría.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, guardar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Enviar formulario
                    document.getElementById('editForm').submit();
                }
            })
        }
    </script>
}