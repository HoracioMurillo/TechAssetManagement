@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Recuperar Contraseña</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-image: linear-gradient( 90.8deg, rgba(27,53,68,1) 2.2%, rgba(110,180,135,1) 84% );
            font-family: 'Segoe UI', Arial, sans-serif;
            color: black;
        }

        .container {
            display: flex;
            flex-direction: row;
            width: 90%;
            max-width: 1000px;
            min-height: 600px;
            background: #fff;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
        }

        .left-panel {
            flex: 1;
            background-image: linear-gradient(120deg, #84fab0 0%, #8fd3f4 100%);
            color: #fff;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .left-panel h1 {
                font-size: 36px;
                margin-bottom: 20px;
            }

            .left-panel p {
                font-size: 16px;
                line-height: 1.5;
            }

        .right-panel {
            flex: 1;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-card h3 {
            margin-bottom: 20px;
            font-weight: bold;
            color: #2c3e50;
        }

        .form-label {
            font-weight: bold;
            color: #2c3e50;
        }

        .form-control {
            margin-bottom: 15px;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #ccc;
            width: 100%;
        }

        .btn-primary {
            background-color: #3498db;
            border: none;
            padding: 12px;
            border-radius: 8px;
            color: #fff;
            font-weight: bold;
            cursor: pointer;
            width: 100%;
        }

            .btn-primary:hover {
                background-color: #2980b9;
            }

        a {
            color: #f1c40f;
            font-size: larger;
            text-align: center;
        }

        .text-end a {
            color: #3498db;
            text-decoration: none;
            font-size: 12px;
        }

            .text-end a:hover {
                text-decoration: underline;
            }

        /* Responsividad */

        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Panel izquierdo -->
        <div class="left-panel">
            <h1>BIENVENIDO</h1>
            <h2>MODULO DE RECUPERACION DE CONTRASEÑA</h2>

        </div>

        <!-- Panel derecho -->
        <div class="right-panel">
            <div class="login-card">
                <div class="card shadow p-4" style="max-width: 400px; width: 100%;">
                    <h3 class="text-center mb-4">Ingrese sus credenciales para recuperar el acceso <span class="text-primary"></span></h3>
   

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
            <div class="text-center mt-3">
                <a href="@Url.Action("Login", "Access")" class="btn btn-outline-primary">Volver al Login</a>
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                <div class="mb-3">
                    <label class="form-label">Correo Electrónico</label>
                    <input type="email" name="email" class="form-control" required placeholder="ejemplo@empresa.com" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Enviar Enlace</button>
            </form>
            <div class="text-center mt-3">
                <a href="@Url.Action("Login", "Access")" class="text-decoration-none">Volver al Login</a>
            </div>
        }
    </div>
  </div>
 </div>
</div>
</body>
</html>