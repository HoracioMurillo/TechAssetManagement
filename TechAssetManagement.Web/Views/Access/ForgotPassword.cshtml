@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Recuperar Contraseña</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">

    <div class="card shadow p-4" style="max-width: 400px; width: 100%;">
        <div class="text-center mb-4">
            <h3 class="text-primary"><i class="fas fa-lock"></i> Recuperar Acceso</h3>
            <p class="text-muted">Ingresa tu correo para buscar tu cuenta.</p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
            <div class="text-center mt-3">
                <a href="@Url.Action("Login", "Access")" class="btn btn-outline-primary">Volver al Login</a>
            </div>
        }
        else
        {
            <form asp-action="ForgotPassword" method="post">
                <div class="mb-3">
                    <label class="form-label">Correo Electrónico</label>
                    <input type="email" name="email" class="form-control" required placeholder="ejemplo@empresa.com" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Enviar Enlace</button>
            </form>
            <div class="text-center mt-3">
                <a href="@Url.Action("Login", "Access")" class="text-decoration-none">Volver al Login</a>
            </div>
        }
    </div>

</body>
</html>