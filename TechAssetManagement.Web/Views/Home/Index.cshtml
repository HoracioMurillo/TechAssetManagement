@model TechAssetManagement.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h2 class="mb-4">Panel de Control</h2>

    <!-- Tarjetas de Métricas -->
    <!-- Tarjetas de Métricas -->
    <div class="row mb-4">
        <!-- Total Equipos -->
        <div class="col-md-3">
            <a asp-controller="Assets" asp-action="Index" class="text-decoration-none">
                <div class="card text-white bg-primary mb-3 h-100 shadow-sm hover-effect">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-server"></i> Total Equipos</h5>
                        <h2 class="display-4">@Model.TotalAssets</h2>
                        <small class="text-white-50">Ver inventario completo &rarr;</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- Disponibles -->
        <div class="col-md-3">
            <a asp-controller="Assets" asp-action="Index" class="text-decoration-none">
                <div class="card text-white bg-success mb-3 h-100 shadow-sm hover-effect">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-check-circle"></i> Disponibles</h5>
                        <h2 class="display-4">@Model.AvailableAssets</h2>
                        <small class="text-white-50">Asignar equipos &rarr;</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- Tickets Abiertos (Redirige a Tickets) -->
        <div class="col-md-3">
            <a asp-controller="Tickets" asp-action="Index" class="text-decoration-none">
                <div class="card text-white bg-warning text-dark mb-3 h-100 shadow-sm hover-effect">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-ticket-alt"></i> Tickets Abiertos</h5>
                        <h2 class="display-4">@Model.OpenTickets</h2>
                        <small class="text-dark-50">Gestionar pendientes &rarr;</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- Tickets Críticos -->
        <div class="col-md-3">
            <a asp-controller="Tickets" asp-action="Index" class="text-decoration-none">
                <div class="card text-white bg-danger mb-3 h-100 shadow-sm hover-effect">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fas fa-fire"></i> Críticos</h5>
                        <h2 class="display-4">@Model.CriticalTickets</h2>
                        <small class="text-white-50">Ver urgencias &rarr;</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <style>
        /* Efecto visual al pasar el mouse */
        .hover-effect:hover {
            transform: translateY(-5px);
            transition: 0.3s;
            cursor: pointer;
            opacity: 0.9;
        }
    </style>

    <!-- Tabla de Tickets Recientes -->
    <div class="card shadow">
        <div class="card-header bg-white border-0">
            <h5 class="mb-0">Últimos Tickets Reportados</h5>
        </div>
        <div class="table-responsive">
            <table class="table align-items-center table-flush">
                <thead class="thead-light">
                    <tr>
                        <th>Título</th>
                        <th>Solicitante</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model.RecentTickets)
                    {
                        <tr>
                            <td>@ticket.Title</td>
                            <td>@ticket.RequestedByUser?.FullName</td>
                            <td>
                                @if (ticket.Priority == "Critical")
                                {
                                    <span class="badge bg-danger">Crítico</span>
                                }
                                else if (ticket.Priority == "High")
                                {

                                    <span class="badge bg-warning text-dark">Alto</span>
                                }
                                else
                                {

                                    <span class="badge bg-info">@ticket.Priority</span>
                                }
                            </td>
                            <td>@ticket.Status</td>
                            <td>@ticket.CreatedAt.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                    @if (!Model.RecentTickets.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No hay tickets recientes.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>